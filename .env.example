# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ── Database (direct Postgres URL for SQLAlchemy / Alembic) ───────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project-id.supabase.co:5432/postgres

# ── Data Ingestion APIs ───────────────────────────────────────────────────────
APIFY_TOKEN=apify_api_your_token_here
RENTCAST_API_KEY=your_rentcast_api_key_here

# ── Neighborhood APIs ─────────────────────────────────────────────────────────
WALKSCORE_API_KEY=your_walkscore_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── AI Visual Scoring (optional — Street View scoring via Claude) ──────────────
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# ── STR Comp Validation ───────────────────────────────────────────────────────
# STR comps are fetched via the Apify tri_angle/airbnb-scraper actor.
# No separate API key required — uses APIFY_TOKEN above.

# ── Email Delivery ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key_here
DIGEST_RECIPIENT_EMAIL=you@example.com
DIGEST_FROM_EMAIL=analyzer@yourdomain.com

# ── App Config ────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
SECRET_KEY=change_me_to_a_long_random_string
LOG_LEVEL=INFO

# ── Jacksonville Market Defaults (override per-run if needed) ─────────────────
DEFAULT_MARKET=jacksonville_fl
DEFAULT_INTEREST_RATE=0.075
DEFAULT_DOWN_PAYMENT_PCT=0.20
